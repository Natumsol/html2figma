---
import { t, type Language, link } from '../lib/i18n';
import { GalleryGrid } from './site/GalleryGrid';
import { cases } from '../data/cases';
interface Props { language: Language }
const { language } = Astro.props;
---
<section class="gallery-heading wrap reveal" aria-labelledby="gallery-title">
  <div class="gallery-intro">
    <div class="gallery-title-line">
      <h1 id="gallery-title">{t(language, 'Conversion examples', '转换案例')}</h1>
      <span class="gallery-count">{String(cases.length).padStart(2, '0')}<span class="sr-only"> {t(language, 'examples', '个案例')}</span></span>
    </div>
    <p class="gallery-description">{t(language, 'Preview HTML, copy JSON, or edit in Playground.', '预览网页、复制 JSON，或在 Playground 中编辑。')}</p>
  </div>
  <div class="gallery-heading-meta">
    <p class="gallery-note">{t(language, 'Illustrative content and values.', '内容与数值仅作示例。')}</p>
    <a class="text-link gallery-guide" href={link(language, 'docs/plugin')}>{t(language, 'Figma plugin', 'Figma 插件')} ↗</a>
  </div>
</section>
<GalleryGrid language={language} client:load />

{
  "name": "html2figma-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "node scripts/run-astro.mjs dev development",
    "build": "node scripts/run-astro.mjs build",
    "check": "npm run prepare:assets && astro check && tsc --noEmit -p plugin/tsconfig.json && node scripts/check-doc-examples.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4322 --ignore-lock",
    "test": "playwright test",
    "verify": "npm run test:config && npm run check && npm run build:preview && npm run test",
    "build:preview": "node scripts/run-astro.mjs build preview",
    "build:production": "node scripts/run-astro.mjs build production",
    "test:config": "node --test scripts/environment.test.mjs",
    "env:development": "node scripts/vercel.mjs env development",
    "env:preview": "node scripts/vercel.mjs env preview",
    "env:production": "node scripts/vercel.mjs env production",
    "vercel:build": "node scripts/vercel.mjs build preview",
    "vercel:build:production": "node scripts/vercel.mjs build production",
    "deploy": "node scripts/vercel.mjs deploy preview",
    "deploy:production": "node scripts/vercel.mjs deploy production"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "@astrojs/react": "7.0.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@gsap/react": "2.1.2",
    "@lezer/highlight": "1.2.5",
    "@tailwindcss/vite": "4.3.3",
    "@vercel/analytics": "2.0.1",
    "astro": "7.3.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "codemirror": "6.0.2",
    "gsap": "3.15.0",
    "html2figma": "1.0.2",
    "lucide-react": "1.55.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@figma/plugin-typings": "1.141.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}

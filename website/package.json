{
  "name": "html2figma-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare:assets && astro dev --host 127.0.0.1",
    "build": "npm run prepare:assets && astro build",
    "check": "npm run prepare:assets && astro check && tsc --noEmit -p plugin/tsconfig.json && node scripts/check-doc-examples.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "playwright test",
    "verify": "npm run check && npm run build && npm run test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@gsap/react": "2.1.2",
    "@lezer/highlight": "1.2.5",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "codemirror": "6.0.2",
    "gsap": "3.15.0",
    "html2figma": "1.0.2",
    "lucide-react": "1.55.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@figma/plugin-typings": "1.141.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}

{
  "name": "html2figma",
  "version": "0.1.0",
  "description": "Convert HTML DOM trees into Figma plugin scene nodes.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./convert": {
      "types": "./dist/convert.d.ts",
      "import": "./dist/convert.js",
      "require": "./dist/convert.cjs"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js",
      "require": "./dist/render.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run build",
    "example:verify": "npm run build && npm --prefix example ci && npm --prefix example run typecheck && npm --prefix example run build",
    "e2e:build": "npm --prefix example run build",
    "e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json",
    "test:e2e": "npm run e2e:build && playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "npm run e2e:build && playwright test -c e2e/playwright.config.ts --ui",
    "e2e:report": "playwright show-report playwright-report/e2e",
    "e2e:visual:prepare": "npm run e2e:build && node e2e/visual/prepare.mjs",
    "test:e2e:visual": "playwright test -c e2e/visual/compare.config.ts"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.108.0",
    "@fontsource/inter": "4.5.15",
    "@playwright/test": "^1.52.0",
    "@types/chrome": "^0.0.306",
    "@types/node": "^22.20.4",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM"],
    "types": ["@figma/plugin-typings", "node"]
  },
  "include": ["src", "scripts", "*.config.ts", "example.config.ts"]
}
